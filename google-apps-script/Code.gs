const SPREADSHEET_ID = "13tsFPF3xVuG2-3yfbWWSVwJ_Pp9G41SIs6jI0NFIFjg";
function ss(){return SpreadsheetApp.openById(SPREADSHEET_ID)}
function setupSheets(){const book=ss();const configs=[["Products",["SKU","Product Name","Size","Price","Stock"],[["HH-001","น้ำผึ้งดอกลำไย","250 กรัม",159,50],["HH-002","น้ำผึ้งป่า","500 กรัม",279,35]]],["Orders",["Order ID","Created At","Customer Name","Phone","Address","Postcode","Note","Items JSON","Total","Status"],[]]];configs.forEach(c=>{let sh=book.getSheetByName(c[0])||book.insertSheet(c[0]);if(sh.getLastRow()===0){sh.appendRow(c[1]);if(c[2].length)sh.getRange(2,1,c[2].length,c[2][0].length).setValues(c[2]);sh.setFrozenRows(1)}});return "Sheets ready"}
function doGet(){return ContentService.createTextOutput(JSON.stringify({success:true,message:"Honey House API is running"})).setMimeType(ContentService.MimeType.JSON)}
function doPost(e){try{const body=JSON.parse(e.postData.contents||"{}");if(body.action!=="createOrder")throw new Error("Invalid action");const order=body.order||{},customer=order.customer||{},items=order.items||[];if(!customer.name||!customer.phone||!customer.address||!customer.postcode||!items.length)throw new Error("กรุณากรอกข้อมูลให้ครบ");const book=ss(),products=book.getSheetByName("Products"),orders=book.getSheetByName("Orders");if(!products||!orders)throw new Error("กรุณารัน setupSheets ก่อน");const data=products.getDataRange().getValues(),lookup={};data.slice(1).forEach(r=>lookup[r[0]]={name:r[1],price:Number(r[3]),stock:Number(r[4]),row:data.indexOf(r)+1});let total=0,lines=[];items.forEach(it=>{const p=lookup[it.sku],q=Math.floor(Number(it.quantity));if(!p||q<1||p.stock<q)throw new Error("สินค้าไม่เพียงพอ: "+it.sku);total+=p.price*q;lines.push({sku:it.sku,name:p.name,quantity:q,price:p.price})});const lock=LockService.getScriptLock();lock.waitLock(10000);try{items.forEach(it=>{const p=lookup[it.sku];products.getRange(p.row,5).setValue(p.stock-Math.floor(Number(it.quantity)))});const id="HH"+Utilities.formatDate(new Date(),Session.getScriptTimeZone(),"yyyyMMddHHmmss");orders.appendRow([id,new Date(),customer.name,customer.phone,customer.address,customer.postcode,customer.note||"",JSON.stringify(lines),total,"รอแพ็ก"]);return json({success:true,orderId:id,total:total})}finally{lock.releaseLock()}}catch(err){return json({success:false,message:err.message})}}
function json(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}
